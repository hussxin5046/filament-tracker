DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Proxies in front of the app: 0 locally, 1 on most hosts. Rate limits count per visitor only when this is right.
# TRUST_PROXY=0
# Files sent with outside job requests (all optional; these are the defaults)
# UPLOAD_DIR="uploads"
# UPLOAD_MAX_MB=50
# UPLOAD_MAX_FILES=5
# UPLOAD_EXTENSIONS="3mf,stl,step,stp,obj,amf,gcode,nc,svg,dxf,pdf,png,jpg,jpeg,txt"
# UPLOAD_MAX_WORKSPACE_MB=500
# UPLOAD_MIN_FREE_MB=100
# UPLOAD_KEEP_DAYS=90
# Emails: password reset links and status updates to requesters (optional).
# With neither RESEND_API_KEY nor SMTP_URL, emails are printed to the server log.
# RESEND_API_KEY="re_..."
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="Workshop <workshop@example.com>"
# APP_URL="https://wrkbench.example.com"
# Whether new accounts must open an emailed link before they can be added to someone else's workspace:
# auto (only when email is set up above), on, or off. With "on" and no email settings the link is in the server log.
# EMAIL_CONFIRMATION=auto
# Whether new passwords are looked up among passwords known from data leaks (Have I Been Pwned's range lookup:
# the password and its full hash never leave the server). "off" makes no outside call.
# PASSWORD_BREACH_CHECK=on
# Demo account created by `npm run db:seed` (local development only)
SEED_EMAIL="demo@workshop.test"
# At least 12 characters.
SEED_PASSWORD="choose-a-password"
SEED_NAME="Demo Maker"
# Connected printers (optional; these are the defaults)
# PRINTERS_ENABLED=true
# BRIDGE_MAX_PER_WORKSPACE=3
# PRINTER_MAX_PER_BRIDGE=20
# BRIDGE_IMAGE="ghcr.io/hussxin5046/wrkbench-bridge:latest"
# Location displays (optional; these are the defaults)
# DEVICES_ENABLED=true
# DEVICE_MAX_PER_WORKSPACE=5
# Nightly backups of the database and uploads to S3-compatible storage (optional). Set the first four together.
# BACKUP_S3_ENDPOINT="https://<account id>.r2.cloudflarestorage.com"
# BACKUP_S3_BUCKET="wrkbench-backups"
# BACKUP_S3_ACCESS_KEY_ID="..."
# BACKUP_S3_SECRET_ACCESS_KEY="..."
# BACKUP_S3_REGION="auto"
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Who is emailed when a backup fails (optional)
# ALERT_EMAIL="you@example.com"

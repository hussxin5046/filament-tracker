{
  "name": "@filament-tracker/server",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:deploy": "prisma migrate deploy",
    "account:two-step-off": "tsx --env-file-if-exists=.env scripts/two-step-off.ts",
    "account:passkeys-off": "tsx --env-file-if-exists=.env scripts/passkeys-off.ts",
    "db:prepare": "tsx --env-file-if-exists=.env scripts/prestart.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts now",
    "db:backups": "tsx --env-file-if-exists=.env scripts/backup.ts list",
    "db:restore": "tsx --env-file-if-exists=.env scripts/backup.ts restore",
    "reference:filaments": "tsx scripts/import-filaments.ts",
    "reference:passwords": "tsx scripts/import-common-passwords.ts",
    "test": "vitest run",
    "reference:hms": "tsx scripts/import-hms.ts"
  },
  "dependencies": {
    "@filament-tracker/protocol": "1.0.0",
    "@prisma/client": "^6.19.0",
    "@simplewebauthn/server": "^14.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "prisma": "^6.19.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}

// Filament Tracker data model.
// Deliberately generic: categories, units, machines and item fields are rows, not columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// A try-it-out session without an email or password. Removed after a week unless it registers.
  isGuest      Boolean  @default(false)
  /// When the user proved the email address is theirs, by opening a link sent to it. Null until then.
  /// An unconfirmed account works, but cannot be added to someone else's workspace.
  emailVerifiedAt DateTime?
  /// Two-step sign-in. The authenticator secret, encrypted with a key made from JWT_SECRET ("v1.<iv>.<tag>.<data>"),
  /// so a copy of the database alone gives nobody working codes. Set when set-up starts.
  totpSecret      String?
  /// When the first code proved the app works. Two-step sign-in is on from then; null while only set up, or off.
  totpEnabledAt   DateTime?
  /// The 30-second step of the last code accepted, so the same code cannot be used twice.
  totpLastStep    Int?
  /// Part of every sign-in token. Raising it signs the user out everywhere and cancels pending reset links.
  tokenVersion Int      @default(0)
  /// Appearance. themeMode: "system" | "light" | "dark". themePreset: a preset id from client/src/lib/themes.ts.
  themeMode    String   @default("system")
  themePreset  String   @default("graphite")
  /// "#rrggbb", or null to use the preset's own accent.
  themeAccent  String?
  /// Order of the main navigation, which items sit in the phone tab bar and which are hidden per device, as JSON
  /// { order: string[], tabBar: string[], hiddenDesktop: string[], hiddenPhone: string[] }. Null for the standard layout.
  navLayout    String?
  /// Whether the daily report opens by itself on the first visit of the day. The button always opens it.
  dailyReportAuto Boolean @default(true)
  createdAt    DateTime @default(now())

  memberships     Membership[]
  stockMovements  StockMovement[]
  maintenanceLogs MaintenanceLog[]
  jobs            Job[]
  reviewedRequests JobRequest[]
  requestComments  JobRequestComment[]
  activities       ActivityLog[]
  recoveryCodes    RecoveryCode[]
  passkeys         Passkey[]
}

/// A single-use code that signs in instead of the authenticator app, for a lost phone. Shown once, when two-step
/// sign-in is turned on; only its SHA-256 is stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A passkey: a key pair held by the member's device, which signs them in on its own, without the password or the
/// two-step code. Only the public half is here, so a copy of the database gives nobody a way in.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// What the device calls this passkey (base64url). It names itself with this when signing in.
  credentialId String    @unique
  /// The public key, in the COSE form the device gave it in.
  publicKey    Bytes
  /// How many times the device says it has signed. A sign-in whose count is not higher than this is refused, because
  /// it means the passkey was copied. Passkeys that sync between devices always say 0, which is allowed.
  counter      BigInt    @default(0)
  /// What the member calls it, e.g. "iPhone".
  name         String
  /// The site address it was made for (the WebAuthn relying party ID). It works nowhere else.
  site         String
  /// How the device can be reached ("internal", "hybrid", "usb" ...), comma separated, as a hint for the browser.
  transports   String?
  /// Whether the device says the passkey is kept in a synced account (iCloud, Google ...) and not on one device only.
  synced       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The random value a device signs when a passkey is added or used. Each works once, for five minutes.
/// purpose: "add" (then userId says for whom) | "sign-in" (nobody is known yet).
model PasskeyChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  purpose   String
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  currency    String   @default("GBP")
  /// Profit wanted on a project, as a percentage of its price. Used to recommend a price from its cost.
  targetMargin Float   @default(40)
  /// Secret part of the public "request a job" link. Null while outside requests are switched off.
  requestToken String? @unique
  createdAt   DateTime @default(now())

  jobRequests      JobRequest[]
  projects         Project[]
  members          Membership[]
  units            Unit[]
  suppliers        Supplier[]
  locations        Location[]
  itemTypes        ItemType[]
  items            Item[]
  machineTypes     MachineType[]
  machines         Machine[]
  subUnits         SubUnit[]
  maintenanceTasks MaintenanceTask[]
  jobs             Job[]
  stockMovements   StockMovement[]
  activities       ActivityLog[]
  bridges          Bridge[]
  printerLinks     PrinterLink[]
  devices          Device[]
  unknownTags      UnknownTag[]
}

/// One counted try at something that must not be guessed, such as a password. Kept here, not in memory, so a
/// restart does not hand out a fresh allowance. `key` is a SHA-256 of what was tried ("login:<email>"), so the
/// table never holds an address nobody registered.
model SignInAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

/// role: "owner" | "admin" | "operator" | "viewer"
/// Owners also manage members and the workspace itself. Admins change everything else.
/// Operators run jobs and log what they use, but cannot change the inventory or delete anything.
model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

/// User-defined unit of measure (g, m, pcs, sheets, ml ...).
model Unit {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  symbol      String
  /// Decimal places shown and accepted when entering quantities.
  decimals    Int    @default(0)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itemTypes ItemType[]
  items     Item[]

  @@unique([workspaceId, symbol])
}

model Supplier {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  website     String @default("")
  email       String @default("")
  notes       String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     Item[]

  @@unique([workspaceId, name])
}

/// Hierarchy: any depth. `kind` is free text (Room, Shelf, Bin ...). `code` is the label printed as QR/barcode.
model Location {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  kind        String  @default("")
  code        String  @default("")
  parentId    String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Location[] @relation("LocationTree")
  items     Item[]
  machines  Machine[]
  devices   Device[]

  @@index([workspaceId])
  @@index([parentId])
}

/// A user-defined category of item. Custom fields hang off it.
model ItemType {
  id            String  @id @default(cuid())
  workspaceId   String
  name          String
  /// Lucide icon name chosen from the icon picker.
  icon          String  @default("Package")
  /// Token palette name (see client tokens), not a raw colour.
  color         String  @default("slate")
  defaultUnitId String?
  /// When true, items of this type accrue usage hours from jobs (tooling) instead of only being consumed.
  tracksLife    Boolean @default(false)
  sortOrder     Int     @default(0)

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultUnit Unit?         @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  fields      CustomField[]
  items       Item[]

  @@unique([workspaceId, name])
}

/// fieldType: "text" | "number" | "select" | "boolean" | "color" | "date"
model CustomField {
  id              String  @id @default(cuid())
  itemTypeId      String
  key             String
  label           String
  fieldType       String
  unit            String  @default("")
  /// JSON array of strings, used by "select".
  options         Json
  required        Boolean @default(false)
  showInList      Boolean @default(true)
  /// Numeric fields flagged here describe the physical size of a piece and drive the "will it fit" search.
  isSizeDimension Boolean @default(false)
  sortOrder       Int     @default(0)

  itemType ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)

  @@unique([itemTypeId, key])
}

model Item {
  id          String   @id @default(cuid())
  workspaceId String
  itemTypeId  String
  name        String
  sku         String   @default("")
  quantity    Float    @default(0)
  /// Quantity when full/new (e.g. 1000 g spool). Optional; enables a fill gauge.
  capacity    Float?
  minQuantity Float    @default(0)
  /// Cost per one unit of `unit`.
  unitCost    Float    @default(0)
  unitId      String?
  supplierId  String?
  locationId  String?
  notes       String   @default("")
  /// Custom field values keyed by CustomField.key.
  fields      Json
  /// Tool life: hours accrued from jobs, expected life, and a manual/automatic wear flag.
  usageHours  Float    @default(0)
  lifeHours   Float?
  wearFlag    Boolean  @default(false)
  /// Offcut / remnant of another item.
  isRemnant   Boolean  @default(false)
  parentId    String?
  /// The id read from the spool's own tag (RFID today, a printed label later). Lets a printer recognise the spool.
  tagId       String?
  /// Set while the spool is "on the move": tapped out at a location display's reader and not yet put away or loaded in a machine.
  outSince    DateTime?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itemType           ItemType         @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  unit               Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier           Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location           Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parent             Item?            @relation("ItemRemnants", fields: [parentId], references: [id], onDelete: SetNull)
  remnants           Item[]           @relation("ItemRemnants")
  compatibleMachines Machine[]        @relation("ItemMachineCompatibility")
  slot               Slot?
  movements          StockMovement[]
  jobUsages          JobUsage[]
  maintenanceParts   MaintenancePart[]

  @@index([workspaceId, itemTypeId])
  @@index([workspaceId, tagId])
  @@index([workspaceId, outSince])
}

model MachineType {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  icon        String @default("Cog")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machines         Machine[]
  maintenanceTasks MaintenanceTask[]

  @@unique([workspaceId, name])
}

/// status: "ready" | "in_use" | "needs_service" | "offline"
model Machine {
  id            String   @id @default(cuid())
  workspaceId   String
  machineTypeId String?
  name          String
  manufacturer  String   @default("")
  model         String   @default("")
  serial        String   @default("")
  status        String   @default("ready")
  usageHours    Float    @default(0)
  /// Running cost per hour, added to job cost.
  hourlyCost    Float    @default(0)
  locationId    String?
  notes         String   @default("")
  /// JSON array of { label, value, unit } - fixed specifications such as build volume or laser power.
  specs         Json     @default("[]")
  createdAt     DateTime @default(now())

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machineType      MachineType?      @relation(fields: [machineTypeId], references: [id], onDelete: SetNull)
  location         Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  compatibleItems  Item[]            @relation("ItemMachineCompatibility")
  subUnits         SubUnit[]
  maintenanceTasks MaintenanceTask[]
  maintenanceLogs  MaintenanceLog[]
  jobs             Job[]
  jobRequests      JobRequest[]
  printerLink      PrinterLink?
  devices          Device[]

  @@index([workspaceId])
}

/// Hardware attached to a machine (multi-material feeder, tool changer, dryer ...).
model SubUnit {
  id          String  @id @default(cuid())
  workspaceId String
  machineId   String?
  name        String
  kind        String  @default("")
  /// JSON array of { label, value, unit } - user-defined readings such as humidity.
  readings    Json
  statusNote  String  @default("")
  /// Set when a connected printer reports this unit ("bambu:<serial>:ams:0"). The printer then decides its
  /// slots, readings and status note; null for units kept by hand.
  externalId  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machine   Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  slots     Slot[]

  @@index([workspaceId, externalId])
  @@index([machineId])
}

model Slot {
  id        String  @id @default(cuid())
  subUnitId String
  position  Int
  label     String  @default("")
  itemId    String? @unique
  /// What a connected printer last saw in this slot: { state, material, subType, colour, colours, brand, tagId,
  /// remainingPercent, spoolWeightGrams, signature, boundSignature }. Null for slots no printer reports.
  detected  Json?
  /// Who put the item here: "manual" (a member) | "printer" (recognised by its tag).
  source    String  @default("manual")

  subUnit SubUnit @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([subUnitId, position])
}

/// Recurring schedule. Attach to one machine, or to a machine type to cover every machine of that type.
/// Due when either interval elapses (date and/or usage hours) since the last log for that machine.
model MaintenanceTask {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String   @default("")
  machineId     String?
  machineTypeId String?
  intervalDays  Float?
  intervalHours Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machine     Machine?         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineType MachineType?     @relation(fields: [machineTypeId], references: [id], onDelete: Cascade)
  logs        MaintenanceLog[]

  @@index([workspaceId])
}

model MaintenanceLog {
  id             String   @id @default(cuid())
  taskId         String
  machineId      String
  performedAt    DateTime @default(now())
  hoursAtService Float    @default(0)
  notes          String   @default("")
  userId         String?

  task    MaintenanceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  machine Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  parts   MaintenancePart[]

  @@index([taskId, machineId, performedAt])
  @@index([machineId])
}

model MaintenancePart {
  id       String @id @default(cuid())
  logId    String
  itemId   String
  quantity Float

  log  MaintenanceLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  item Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([itemId])
}

/// status: "planned" | "in_progress" | "completed" | "failed" | "cancelled"
model Job {
  id            String    @id @default(cuid())
  workspaceId   String
  machineId     String?
  name          String
  status        String    @default("planned")
  durationHours Float     @default(0)
  notes         String    @default("")
  /// Anything not captured by materials/tooling/machine time (labour, outsourcing ...).
  extraCost     Float     @default(0)
  /// Snapshots written when the job is completed.
  materialCost  Float     @default(0)
  toolingCost   Float     @default(0)
  machineCost   Float     @default(0)
  totalCost     Float     @default(0)
  createdById   String?
  /// Print queue: higher priority runs first on its machine, then queuePosition (set by dragging), then age.
  priority      Int       @default(0)
  queuePosition Int       @default(0)
  startedAt     DateTime?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  /// Who made the job: "manual" (a member) | "printer" (a connected printer was seen starting a print).
  source        String    @default("manual")
  /// Why it failed, when a connected printer said: its error text, or "Cancelled at the printer".
  failureReason String    @default("")
  /// The project this job is part of, if any.
  projectId     String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machine   Machine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      PrinterRun[]
  usages    JobUsage[]
  movements StockMovement[]
  request   JobRequest?

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([workspaceId, completedAt])
}

/// A piece of work for one customer, made up of jobs. It adds up what its jobs cost and sets that
/// against the price invoiced for it.
/// stage: "open" | "invoiced" | "paid"
model Project {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  customer      String   @default("")
  notes         String   @default("")
  stage         String   @default("open")
  /// The price invoiced for the whole project. Null until one is set.
  price         Float?
  /// Target margin for this project alone. Null uses the workspace's.
  marginPercent Float?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs      Job[]

  @@index([workspaceId, stage])
}

/// A job asked for by someone outside the workspace, through the public request link.
/// It waits in a queue until an editor checks the files and approves it (which creates a planned Job),
/// asks for changes, or rejects it.
/// status: "pending" | "changes_requested" | "approved" | "in_progress" | "done" | "rejected"
/// in_progress and done follow the job made from it, and can also be set by hand.
model JobRequest {
  id             String    @id @default(cuid())
  workspaceId    String
  /// The machine the requester asked for, if any.
  machineId      String?
  title          String
  details        String    @default("")
  requesterName  String
  requesterEmail String
  status         String    @default("pending")
  /// What the reviewer told the requester.
  reviewNote     String    @default("")
  reviewedById   String?
  reviewedAt     DateTime?
  /// Secret part of the link the requester follows progress with.
  trackToken     String    @unique
  jobId          String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machine    Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  reviewedBy User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  job        Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  files      JobRequestFile[]
  comments   JobRequestComment[]

  @@index([workspaceId, status])
}

/// A message on a request, from a member or from the requester (through their progress link).
/// The requester sees every comment.
model JobRequestComment {
  id            String   @id @default(cuid())
  requestId     String
  /// Null when the requester wrote it, or when the member has since been deleted.
  userId        String?
  authorName    String
  fromRequester Boolean  @default(false)
  body          String
  createdAt     DateTime @default(now())

  request JobRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

/// A file sent with a request. The bytes live on disk under UPLOAD_DIR/<workspaceId>/<storedName>.
model JobRequestFile {
  id         String   @id @default(cuid())
  requestId  String
  /// The name the requester's file had, cleaned up. Shown and used for downloads.
  name       String
  /// Random name on disk, so an uploaded name can never choose where a file is written.
  storedName String
  size       Int
  createdAt  DateTime @default(now())

  request JobRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// One line of a job: `quantity` is consumed from stock, `hours` is added to the item's tool life.
model JobUsage {
  id       String @id @default(cuid())
  jobId    String
  itemId   String
  quantity Float  @default(0)
  hours    Float  @default(0)
  /// Snapshot written on completion.
  cost     Float  @default(0)

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([itemId])
}

/// Audit trail of every stock change. reason: "initial" | "restock" | "adjust" | "job" | "maintenance" | "import" | "undo"
model StockMovement {
  id           String   @id @default(cuid())
  workspaceId  String
  itemId       String
  delta        Float
  balanceAfter Float
  reason       String
  note         String   @default("")
  jobId        String?
  userId       String?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([jobId])
}

/// Who changed what and when: one row per successful change a member makes.
/// Stock edits list the movements they made in `movementIds`, which is what lets them be undone.
model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  /// Kept so the log still reads right after the member is removed.
  userName    String    @default("")
  /// Short kind such as "item.adjust", "job.finish", "member.add".
  action      String
  /// What it happened to ("item", "job", "machine" ...) and its id, when there is one.
  entityType  String    @default("")
  entityId    String?
  /// A sentence for people: "Adjusted PLA Black by -120".
  summary     String
  /// JSON array of StockMovement ids made by this change.
  movementIds Json
  undoneAt    DateTime?
  undoneById  String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

/// A small program on the workshop's own network that talks to its printers and reports here.
/// It signs in with a long random token; only the token's SHA-256 is stored.
/// Whether it is online is not stored: it is online while its socket is connected.
model Bridge {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  /// SHA-256 (hex) of the bridge token. Null until a pairing code has been swapped for one.
  tokenHash        String?   @unique
  /// SHA-256 (hex) of the one-time pairing code while one is waiting to be used.
  pairingHash      String?   @unique
  pairingExpiresAt DateTime?
  /// Reported by the bridge each time it connects.
  version          String    @default("")
  platform         String    @default("")
  /// JSON array of strings: what this build can do ("bambu.monitor", "discovery" ...).
  capabilities     Json
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  printers  PrinterLink[]

  @@index([workspaceId])
}

/// Ties a machine to a real printer reached through a bridge, so Machine itself stays generic.
/// vendor: "bambu"
/// codeState: "ok" | "missing" | "rejected" - whether the bridge holds a working access code.
/// The access code itself is never stored here: it is handed to the bridge once and lives only there.
model PrinterLink {
  id          String    @id @default(cuid())
  workspaceId String
  machineId   String    @unique
  bridgeId    String
  vendor      String    @default("bambu")
  serial      String
  /// Address on the workshop's network, as the bridge reaches it.
  host        String
  /// Filled in from the printer.
  modelName   String    @default("")
  firmware    String    @default("")
  codeState   String    @default("ok")
  /// The last state read from the printer, shown while the bridge is away. Written on real changes and at most once a minute.
  lastState   Json?
  lastStateAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machine   Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  bridge    Bridge    @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  runs      PrinterRun[]

  @@unique([workspaceId, serial])
  @@index([bridgeId])
}

/// A small screen of Wrkbench's own fixed to a shelf, rack or dry box (kind "location_display").
/// It signs in with a long random token like a bridge, but over plain HTTP polls rather than a socket,
/// so "online" is read from lastSeenAt. Only the token's SHA-256 is stored.
model Device {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  kind             String    @default("location_display")
  /// The location it shows. Null until one is chosen, or after that location is deleted.
  locationId       String?
  /// The printer it sits beside, for "this spool is going into the printer" from a tapped tag.
  machineId        String?
  /// Whether tapping a tag on it may move items, mark a spool for a printer or link a tag.
  canWrite         Boolean   @default(true)
  /// SHA-256 (hex) of the device token. Null until a set-up code has been swapped for one.
  tokenHash        String?   @unique
  /// SHA-256 (hex) of the one-time set-up code while one is waiting to be used.
  pairingHash      String?   @unique
  pairingExpiresAt DateTime?
  /// Reported by the device when it pairs: its hardware ("cyd-28-st7789+pn532") and firmware version.
  model            String    @default("")
  version          String    @default("")
  /// Whether its tag reader answered on the last poll.
  hasReader        Boolean   @default(false)
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  machine     Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  unknownTags UnknownTag[]

  @@index([workspaceId])
}

/// A Bambu Lab spool tapped on a display's reader that nothing in stock is tied to yet. It waits here until a
/// member says which item it is, or adds it as a new one.
model UnknownTag {
  id          String   @id @default(cuid())
  workspaceId String
  deviceId    String?
  tagId       String
  /// What the tag says about the spool, in the shape a slot keeps for a printer's tray (see spoolMatch.ts).
  detected    Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, tagId])
}

/// One print a connected printer was seen making, from start to end. It ties the print to its job and keeps
/// what the sliced file said it would use.
/// outcome: "" while running | "completed" | "failed" | "cancelled" | "unseen" (it ended while nobody was listening)
/// usageSource: "" (not known) | "file" (read from the sliced file) | "manual"
model PrinterRun {
  id            String    @id @default(cuid())
  workspaceId   String
  printerLinkId String
  jobId         String?
  /// The print's name as the printer reports it; with the start time it tells one print from the next.
  name          String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  outcome       String    @default("")
  /// JSON array, one per filament the print uses: { id, material, colour, grams, feeder, position, itemId, itemName }.
  /// grams is the sliced file's estimate for the whole print.
  filaments     Json
  usageSource   String    @default("")
  /// The furthest the print was seen to get, 0 to 1. Used to scale what a stopped print used.
  progress      Float     @default(0)
  /// The slicer's picture of the plate, read from the sliced file: the name of a PNG in the workspace's upload
  /// folder, or "" when there is none.
  thumbnail     String    @default("")

  printerLink PrinterLink @relation(fields: [printerLinkId], references: [id], onDelete: Cascade)
  job         Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([printerLinkId, endedAt])
  @@index([workspaceId, startedAt])
}

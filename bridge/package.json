{
  "name": "wrkbench-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Runs on the workshop's network, reads its printers and reports to Wrkbench. Read-only: it cannot command a printer.",
  "bin": {
    "wrkbench-bridge": "dist/cli.cjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@filament-tracker/protocol": "1.0.0",
    "fflate": "^0.8.2",
    "mqtt": "^5.10.0",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
